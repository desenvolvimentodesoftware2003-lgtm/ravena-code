# ─────────────────────────────────────────────────────────────────
# Ravena — variaveis de ambiente
#
# Copie para .env e preencha.   cp .env.example .env
#
# O .env esta no .gitignore e NUNCA deve ser commitado. Este arquivo
# vai junto no git de proposito: e o contrato do que o sistema espera.
#
# As variaveis de credencial sao geradas a partir do registro de
# src/core/secrets_manager.py. Ao adicionar um segredo la, este
# arquivo precisa ser regerado:
#     python tools/gerar_env_example.py
#
# Nenhum valor real aqui: vazio e placeholder.
# ─────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════
# CREDENCIAIS — preencha com o valor real
# ═══════════════════════════════════════════════════════════════════
#   CRITICAL  sistema nao sobe sem isso
#   HIGH      comeca a subir, mas trading e recusado
#   MEDIUM    opcional, liga funcionalidade

# [CRITICAL] security/zero_trust
# Chave HMAC para assinatura de tokens entre módulos
RAVENA_ZERO_TRUST_SECRET=

# [HIGH] trading/bybit_connector
# API Key da exchange Bybit
BYBIT_API_KEY=

# [HIGH] trading/bybit_connector
# API Secret da exchange Bybit
BYBIT_API_SECRET=

# [MEDIUM] utils/social_connector  (opcional)
# Token de acesso à API do Instagram
INSTAGRAM_ACCESS_TOKEN=

# [MEDIUM] utils/social_connector  (opcional)
# ID da conta do Instagram
INSTAGRAM_ACCOUNT_ID=

# [MEDIUM] utils/social_connector  (opcional)
# App ID do aplicativo Instagram/Meta
INSTAGRAM_APP_ID=

# [MEDIUM] utils/social_connector  (opcional)
# App Secret do aplicativo Instagram/Meta
INSTAGRAM_APP_SECRET=

# [MEDIUM] trading/fonte_ohlcv  (opcional)
# Chave do London Strategic Edge (dados de mercado OHLCV, 22.966 instrumentos: cripto, acoes, forex, futures, etf, indice, commodity)
LSE_API_KEY=

# [MEDIUM] utils/external_api_manager  (opcional)
# API Key da OpenAI (fallback LLM)
OPENAI_API_KEY=

# [MEDIUM] utils/telegram_bot  (opcional)
# Token do bot do Telegram
TELEGRAM_BOT_TOKEN=

# [MEDIUM] utils/telegram_bot  (opcional)
# Chat ID para notificações do Telegram
TELEGRAM_CHAT_ID=

# [LOW] utils/social_connector  (opcional)
# Modo de operação do LLM (local/hibrido/cloud)
LLM_MODE=

# [LOW] core/omega  (opcional)
# Caminho para o arquivo config_v3.json
RAVENA_CONFIG_PATH=

# [LOW] global  (opcional)
# Ambiente de execução (development/production)
RAVENA_ENV=

# [LOW] core/omega_orchestrator  (opcional)
# Flag de ativação do modo soberano
RAVENA_SOBERANIA=

# ── Segredos lidos no codigo, fora do registro ─────────────────
# [CRITICAL] core/omega
# chave mestra do sistema
RAVENA_SECRET_KEY=

# [MEDIUM] api
# segredo de assinatura de token
JWT_SECRET=

# [MEDIUM] trading
# token do CryptoPanic
CRYPTOPANIC_API_TOKEN=


# ═══════════════════════════════════════════════════════════════════
# CONFIGURACAO — nao e segredo, tem valor padrao
# ═══════════════════════════════════════════════════════════════════
# api — host do backend
API_HOST=

# api — porta do backend
API_PORT=

# trading/bybit_connector — mainnet | testnet
BYBIT_ENV=

# trading/bybit_connector — live | paper
BYBIT_MODE=

# utils — true para mockar (nunca em producao)
CLARIVIDENCIA_MOCK_MODE=

# db — postgresql
DATABASE_URL=

# db — host do Postgres
DB_HOST=

# db — nome do banco
DB_NAME=

# db — senha do banco
DB_PASS=

# db — porta do Postgres
DB_PORT=

# db — usuario do banco
DB_USER=

# sandbox — display X11, se rodar interface grafica
DISPLAY=

# global — true para cair no provedor externo
FALLBACK_TO_EXTERNAL=

# global — true silencia barra de progresso
HF_HUB_DISABLE_PROGRESS_BARS=

# treino — teto de tokens por resposta
LLM_MAX_NEW_TOKENS=

# llm — porta do servico local de LLM
LLM_PORT=

# oci — id do cofre OCI
OCI_VAULT_ID=

# tls — caminho do certificado
RAVENA_TLS_CERT=

# tls — caminho da chave
RAVENA_TLS_KEY=

# web — host do painel
RAVENA_WEB_HOST=

# web — porta do painel
RAVENA_WEB_PORT=

# cache — redis
REDIS_URL=

# agentsearch — base URL do AgentSearch
SCIPHI_API_BASE=

# global — true silencia aviso do transformers
TRANSFORMERS_NO_ADVISORY_WARNINGS=

# llm — true para usar o modelo local
USE_LOCAL_LLM=
