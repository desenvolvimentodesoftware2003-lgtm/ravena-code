{
  "dashboard": {
    "id": null,
    "title": "Sandbox Ravena - Security Dashboard",
    "tags": ["security", "sandbox", "ravena"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total de Ataques",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as value FROM attack_log",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 100},
                {"color": "red", "value": 500}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Ataques Bloqueados",
        "type": "stat",
        "targets": [
          {
            "rawSql": "SELECT COUNT(*) as value FROM attack_log WHERE blocked = TRUE",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 50},
                {"color": "red", "value": 100}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Taxa de Bloqueio (%)",
        "type": "gauge",
        "targets": [
          {
            "rawSql": "SELECT (COUNT(CASE WHEN blocked THEN 1 END) * 100.0 / COUNT(*)) as value FROM attack_log",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 90}
              ]
            }
          }
        },
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Ataques por Tipo",
        "type": "piechart",
        "targets": [
          {
            "rawSql": "SELECT attack_type, COUNT(*) as value FROM attack_log GROUP BY attack_type",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4}
      },
      {
        "id": 5,
        "title": "Ataques ao Longo do Tempo",
        "type": "timeseries",
        "targets": [
          {
            "rawSql": "SELECT DATE_TRUNC('minute', timestamp) as time, COUNT(*) as value FROM attack_log GROUP BY 1 ORDER BY 1",
            "format": "time_series"
          }
        ],
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 4}
      },
      {
        "id": 6,
        "title": "Últimas Tentativas de Ataque",
        "type": "table",
        "targets": [
          {
            "rawSql": "SELECT timestamp, attack_type, endpoint, blocked, ip_address FROM attack_log ORDER BY timestamp DESC LIMIT 20",
            "format": "table"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
