# ============================================
# VARIÁVEIS DE AMBIENTE - SANDBOX RAVENA
# ============================================

# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
FLASK_ENV=sandbox
FLASK_DEBUG=1
SECRET_KEY=sandbox_jwt_secret_key_123

# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ============================================
DB_HOST=ravena-db
DB_PORT=5432
DB_NAME=ravena_sandbox
DB_USER=ravena_test
DB_PASSWORD=sandbox_password_123
DATABASE_URL=postgresql://ravena_test:sandbox_password_123@ravena-db:5432/ravena_sandbox

# ============================================
# CONFIGURAÇÕES DO REDIS
# ============================================
REDIS_URL=redis://ravena-redis:6379/0
REDIS_HOST=ravena-redis
REDIS_PORT=6379

# ============================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================
JWT_SECRET=sandbox_jwt_secret_key_123
JWT_EXPIRATION_HOURS=24

# ============================================
# CONFIGURAÇÕES DE LOG
# ============================================
LOG_LEVEL=DEBUG
LOG_FILE=/app/logs/app.log

# ============================================
# CONFIGURAÇÕES DO MONITORAMENTO
# ============================================
GRAFANA_ADMIN_PASSWORD=sandbox_monitor_123
ELASTICSEARCH_URL=http://ravena-elasticsearch:9200

# ============================================
# CONFIGURAÇÕES DE EMAIL (para testes)
# ============================================
MAIL_SERVER=ravena-mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@sandbox.test
