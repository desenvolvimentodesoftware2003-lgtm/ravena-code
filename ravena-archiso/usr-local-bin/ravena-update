#!/bin/bash
# RAVENA UPDATE - atualizacao assistida do sistema (substitui OTA corporativo)
# Uso: ravena-update [--check | --full]
#  --check : so verifica pacotes atualizaveis
#  --full  : sincroniza espelho + atualiza (pede confirmacao)
#  (sem arg) : menu simples

echo "=== RAVENA UPDATE ==="
echo "Espelho: mirror.ufam.edu.br (BR)"

case "$1" in
  --check)
    echo "Verificando atualizacoes..."
    timeout 60 curl -s "https://mirror.ufam.edu.br/archlinux/core/os/x86_64/core.db" -o /tmp/ravena-core.db 2>/dev/null
    timeout 60 curl -s "https://mirror.ufam.edu.br/archlinux/extra/os/x86_64/extra.db" -o /tmp/ravena-extra.db 2>/dev/null
    echo "Atualizacoes disponiveis (pacote/versao):"
    for db in core extra; do
        # listagem simples: se .db baixado e nao vazio, ha repo novo
        [ -s "/tmp/ravena-$db.db" ] && echo "  repo $db: sincronizado" || echo "  repo $db: FALHA (offline?)"
    done
    ;;
  --full)
    echo "Atualizando pacotes... (pacman -Syu)"
    echo "Processos criticos (ravena-llm, health, tmux) serao mantidos."
    echo "Deseja continuar? [s/N]"
    read -r resp
    case "$resp" in
      s|S|sim|SIM|y|Y|yes|YES)
        sudo pacman -Syu 2>&1 | tee /var/log/ravena-update.log
        echo "Update concluido. Log: /var/log/ravena-update.log"
        ;;
      *) echo "Cancelado. Nenhuma mudanca feita." ;;
    esac
    ;;
  *)
    echo "Uso: ravena-update [--check | --full]"
    echo "  --check : verifica atualizacoes"
    echo "  --full  : atualiza (com confirmacao)"
    ;;
esac
exit 0